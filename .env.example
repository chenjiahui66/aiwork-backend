# ===== MiniMax (https://platform.minimaxi.com) =====
# 官方 OpenAI 兼容 endpoint
MINIMAX_API_KEY=sk-demo-872946abcdef0123456789abcdef0123456789abcdef0123456789
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# ===== LLM (对话生成) =====
LLM_MODEL=MiniMax-M3
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ===== Embedding (本地运行,不走云) =====
# 走 HuggingFace sentence-transformers,首次使用会下载模型(~100MB)
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true

# ===== 切片 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ===== 检索 =====
RETRIEVAL_TOP_K=4

# ===== 服务 =====
APP_HOST=0.0.0.0
APP_PORT=8001

# ===== 路径 =====
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
CHROMA_DIR=./data/chroma