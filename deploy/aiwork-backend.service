[Unit]
Description=AiWork RAG Backend (FastAPI + LangChain + FAISS)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/aiwork-backend
EnvironmentFile=/opt/aiwork-backend/.env
ExecStart=/opt/aiwork-backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 1
Restart=always
RestartSec=3
StandardOutput=append:/var/log/aiwork-backend/out.log
StandardError=append:/var/log/aiwork-backend/err.log

# 资源限制（低内存机器友好）
MemoryMax=512M
MemoryHigh=384M
CPUQuota=80%

[Install]
WantedBy=multi-user.target
